    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe-rs Test",
            "probe": "0451:bef3",
            "cwd": "${workspaceFolder}",
            "connectUnderReset": false,
            "chip": "Cortex-M4",
            "flashingConfig": {
                "flashingEnabled": false,
                "haltAfterReset": true
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "./target/thumbv7em-none-eabihf/debug/${workspaceFolderBasename}"
                }
            ]
        }
    ]
}